@startuml context
!include <C4/C4_Context.puml>

LAYOUT_WITH_LEGEND()

' Персона
Person(user,  "Клиент (не идентифицированный)", "Просматривает актуальные ставки, подает заявку")
Person(user2, "Клиент (идентифицированный)", "Просматривает актуальные ставки, подает и подтверждает заявку")
Person(user3, "Оператор колл-центра", "Обрабатывает заявку в системе колл-центра")
Person(user4, "Менеджер фронт-офиса", "Идентифицирует клиента")
Person(user5, "Менеджер бэк-офиса по депозитам", "Обрабатывает заявку на депозит")
Person(user6, "Менеджер бэк-офиса по кредитованию", "Расчет ставок по депозитам")

' Внешние системы
System_Ext(telecom, "Телеком-оператор", "Отправляет смс клиенту")

' Границы системы
System_Boundary(standart, "MVP Открытие депозитов онлайн") {
    System(system_collaboration, "Приложения банка", "(АБС, сайт, интернет-банк, система колл-центра, смс-шлюз, система управления ставками, система управления заявками)")
}

' Взаимодействия
Rel(user, system_collaboration, "Заходит на сайт компании в раздел депозитов, подает заявку")
Rel(user2, system_collaboration, "Аутентифицируется в интернет-банке, заходит в раздел депозитов, подает и подтверждает по смс заявку")
Rel(user3, system_collaboration, "Обрабатывает заявку в системе колл-центра")
Rel(user4, system_collaboration, "Идентифицирует клиента, загружает документы")
Rel(user5, system_collaboration, "Обрабатывает заявку на депозит")
Rel(system_collaboration, telecom, "Отправка смс через смс-шлюз")
Rel(user6, system_collaboration, "Расчет ставок по депозитам")


@enduml
@startuml containers
!include <C4/C4_Container.puml>

LAYOUT_WITH_LEGEND()

' Персона
Person(user,  "Клиент (не идентифицированный)", "Просматривает актуальные ставки, подает заявку")
Person(user2, "Клиент (идентифицированный)", "Просматривает актуальные ставки, подает и подтверждает заявку")
Person(user3, "Оператор колл-центра", "Обрабатывает заявку в системе колл-центра")
Person(user4, "Менеджер фронт-офиса", "Идентифицирует клиента")
Person(user5, "Менеджер бэк-офиса по депозитам", "Обрабатывает заявку на депозит")
Person(user6, "Менеджер бэк-офиса по кредитованию", "Расчет ставок по депозитам")

System_Boundary(standart, "MVP Открытие депозитов онлайн") {
 
    ' Системы
    Container(website, "Сайт", "php, React.js (собственная разработка)", "Сайт компании, отображение списка депозитов с актуальными ставками")
    Container(internet_bank, "Интернет-банк", "ASP.NET, .NET Framework 4.5 (Платформа подрядчика)", "Аутентификация пользователей, отображение списка депозитов и индивидуальных предложений")
    Container(abs, "АБС", "Delphi (собственная разработка)", "Основная система. Ведет учёт операций по счетам и бухгалтерию")
    Container(crm, "Система колл-центра", "React, Java Spring Boot (Платформа подрядчика)", "Автоматизация функционала колл-центра")
    Container(bet, "Система управления ставками", "React, Java Spring Boot", "Сбор данных, хранение, анализ")
    Container(request, "Система управления онлайн заявками", "React, Java Spring Boot", "Сбор данных, хранение, анализ")
    
    ' СМС шлюз 
    Container(sms, "СМС-шлюз", "", "Передача данных телеком-оператору")

    ' Брокер сообщений
    'Container(broker, "Event Broker", "Kafka", "Асинхронное взаимодействие между сервисами")
    
    ' Базы данных
    ContainerDb(db_internet_bank, "Интернет-банк БД", "MS SQL")
    ContainerDb(db_abs, "АБС БД", "Oracle")
    ContainerDb(db_crm, "Система колл-центра БД", "PostgreSQL")
    ContainerDb(db_bet, "Система управления ставками БД", "PostgreSQL")
    ContainerDb(db_request, "Система управления заявками БД", "PostgreSQL")
}

' Внешние системы
System_Ext(telecom, "Телеком-оператор", "Отправляет смс клиенту")

' === Взаимодействие пользователей ===
Rel(user, website, "Подача заявки на депозит через сайт")
Rel(user2, internet_bank, "Подача и подтверждение заявки на депозит через интернет-банк")
Rel(user3, crm, "Анализ заявки на депозит")
Rel(user4, abs, "Идентификация клиента")
Rel(user5, request, "Обработка онлайн заявки")
Rel(user6, db_bet, "Расчет и обновление ставок на депозит")

' === Синхронные вызовы между сервисами ===
Rel(website, bet, "Запрос актуальных ставок на депозит", "REST API/Sync")
Rel(website, crm, "Передача данных по онлайн заявке с сайта", "REST API/Sync")
Rel(internet_bank, bet, "Запрос актуальных ставок на депозит", "REST API/Sync")
Rel(internet_bank, sms, "Отправка смс для подтверждения операции", "REST API/Sync")
Rel(internet_bank, request, "Отправка данных по онлайн заявке из интернет-банка", "REST API/Sync")
Rel(request, db_abs, "Отправка данных по согласованной онлайн заявке", "JDBC Вызов хранимой процедуры/функции")
Rel(request, sms, "Отправка смс о выдаче депозита", "REST API/Sync")
Rel(crm, sms, "Отправка смс о приглашении в офис", "REST API/Sync")

' === Интеграция с внешними системами ===
Rel(sms, telecom, "Отправка смс")

' === Асинхронное взаимодействие ===

' === Взаимодействие с БД ===
Rel(internet_bank, db_internet_bank, "Чтение/запись", "SQL")
Rel(abs, db_abs, "Чтение/запись", "SQL")
Rel(crm, db_crm, "Чтение/запись", "SQL")
Rel(bet, db_bet, "Чтение/запись", "SQL")
Rel(request, db_request, "Чтение/запись", "SQL")

@enduml
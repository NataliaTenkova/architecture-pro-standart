@startuml containers
!include <C4/C4_Container.puml>

LAYOUT_WITH_LEGEND()

' Персона
Person(user,  "Клиент", "Звонок в колл-центр")
Person(user2, "Оператор колл-центра", "Обрабатывает звонок в системе колл-центра")
Person(user3, "Оператор партнерского колл-центра", "Обрабатывает звонок в системе колл-центра")
Person(user4, "Менеджер бэк-офиса по кредитованию", "Расчет ставок по депозитам")

' Границы системы
System_Boundary(standart, "Передача ставок в колл-центр") {
 
    ' Системы
    Container(crm, "Система колл-центра", "React, Java Spring Boot (Платформа подрядчика)", "Автоматизация функционала колл-центра")
    Container(bet, "Система управления ставками", "React, Java Spring Boot", "Сбор данных, хранение, анализ, выгрузка файлов")
    
    ' Базы данных
    ContainerDb(db_crm, "Система колл-центра БД", "PostgreSQL")
    ContainerDb(db_bet, "Система управления ставками БД", "PostgreSQL")
    ContainerDb(db_bet_redis, "Система управления ставками БД (кеширование)", "Redis")
}

' Внешние системы
System_Ext(sftp, "SFTP-сервер партнера", "Хранит файлы с информацией по ставкам")
System_Ext(crm_ext, "Партнерская система колл-центра", "Автоматизация функционала колл-центра")

' === Взаимодействие пользователей ===
Rel(user, user2, "Звонок в колл-центр")
Rel(user2, crm, "Обработка звонка клиента")
Rel(user2, bet, "Получение данных по ставкам")
Rel(user3, crm_ext, "Обработка звонка клиента")
Rel(user4, bet, "Расчет ставок по депозитам")

' === Интеграция с внешними системами ===
Rel(bet, sftp, "Отправка файла со ставками партнеру", "SFTP-протокол")
Rel(crm_ext, sftp, "Загрузка данных по ставкам в систему")

' === Асинхронное взаимодействие ===

' === Взаимодействие с БД ===
Rel(crm, db_crm, "Чтение/запись", "SQL")
Rel(bet, db_bet, "Чтение/запись", "SQL")
Rel(bet, db_bet_redis, "Чтение/запись", "NoSQL")

@enduml
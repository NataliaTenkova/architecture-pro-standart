@startuml context
!include <C4/C4_Context.puml>

LAYOUT_WITH_LEGEND()

' Персона
Person(user,  "Клиент", "Звонок в колл-центр")
Person(user2, "Оператор колл-центра", "Обрабатывает звонок в системе колл-центра")
Person(user3, "Оператор партнерского колл-центра", "Обрабатывает звонок в системе колл-центра")
Person(user4, "Менеджер бэк-офиса по кредитованию", "Расчет ставок по депозитам")

' Внешние системы
System_Ext(sftp, "SFTP-сервер партнера", "Хранит файлы с информацией по ставкам")
System_Ext(crm_ext, "Партнерская система колл-центра", "Автоматизация функционала колл-центра")

' Границы системы
System_Boundary(standart, "Передача ставок в колл-центр") {
    System(system_collaboration, "Приложения банка", "(Система управления ставками, система колл-центра)")
}

' Взаимодействия
Rel(user, user2, "Звонок в колл-центр")
Rel(user2, system_collaboration, "Обработка звонка клиента")
Rel(user2, system_collaboration, "Получение данных по ставкам")
Rel(user3, crm_ext, "Обработка звонка клиента")
Rel(user4, system_collaboration, "Расчет ставок по депозитам")

Rel(system_collaboration, sftp, "Отправка файла со ставками партнеру", "SFTP-протокол")
Rel(crm_ext, sftp, "Загрузка данных по ставкам в систему")


@enduml
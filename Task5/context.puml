@startuml context
!include <C4/C4_Context.puml>

LAYOUT_WITH_LEGEND()

' Персона
Person(user,  "Клиент (не идентифицированный)", "Просматривает кредитные предложения, подает заявку")
Person(user2, "Клиент (идентифицированный)", "Просматривает кредитные и предодобренные предложения, подает и подтверждает заявку")
Person(user3, "Менеджер фронт-офиса", "Идентифицирует клиента, подпет заявку или продолжает работать по предзаполненной")
Person(user4, "Менеджер бэк-офиса по кредитованию", "Обработка заявок на кредит")

' Внешние системы
System_Ext(telecom, "Телеком-оператор", "Отправляет смс клиенту")
System_Ext(bkh, "Бюро кредитных историй", "Хранит общие сведения по кредитованию клиента")

' Границы системы
System_Boundary(standart, "MVP Открытие кредитов онлайн") {
    System(system_collaboration, "Приложения банка", "(АБС, сайт, интернет-банк, смс-шлюз, система кредитного скоринга, кредитный конвеер, система управления кредитными заявками)")
}

' Взаимодействия
Rel(user, system_collaboration, "Заходит на сайт компании в раздел кредитов, подает заявку, указав ФИО, номер телефона и при желании паспортные данные")
Rel(user2, system_collaboration, "Аутентифицируется в интернет-банке, заходит в раздел кредитов, подает и подтверждает по смс заявку")
Rel(user3, system_collaboration, "Идентифицирует клиента, загружает документы, подает заявку на кредит")
Rel(user4, system_collaboration, "Обрабатывает заявку на кредит")
Rel(system_collaboration, telecom, "Отправка смс через смс-шлюз")
Rel(system_collaboration, bkh, "Запрос данных о клиенте")


@enduml